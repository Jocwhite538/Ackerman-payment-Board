{
  "AllowedHosts": "*",
  "Database": {
    "Provider": "LiteDB",
    "Path": "App_Data/ackerman-payment-board.db",
    "Connection": "Direct"
  },
  "Security": {
    "CookieMinutes": 30,
    "MaxFailedLogins": 5,
    "LockoutMinutes": 15,
    "AllowFirstRunSetup": true,
    "RequireHttps": true
  },
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft.AspNetCore": "Warning"
    }
  },
  "Demo": {
    "SeedPatients": false
  }
}
