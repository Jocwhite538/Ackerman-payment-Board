@model ChangePasswordViewModel
@{ ViewData["Title"] = "Change Password"; }
<div class="auth-card">
  <h2>Change password</h2>
  <p class="intro">Choose a new password with at least 5 characters. Temporary passwords must be changed before using the board.</p>
  <div asp-validation-summary="ModelOnly"></div>
  <form method="post" class="auth-form">
    @Html.AntiForgeryToken()
    <div><label asp-for="CurrentPassword">Current password</label><input asp-for="CurrentPassword" autocomplete="current-password" /><span asp-validation-for="CurrentPassword"></span></div>
    <div><label asp-for="NewPassword">New password</label><input asp-for="NewPassword" autocomplete="new-password" /><span asp-validation-for="NewPassword"></span></div>
    <div><label asp-for="ConfirmPassword">Confirm new password</label><input asp-for="ConfirmPassword" autocomplete="new-password" /><span asp-validation-for="ConfirmPassword"></span></div>
    <button class="btn btn-primary" type="submit">Change Password</button>
  </form>
</div>
